{
  "name": "rdf-serialize",
  "version": "5.0.0",
  "description": "Serializes to any RDF serialization",
  "lsd:module": true,
  "keywords": [
    "rdf",
    "serialize",
    "stream",
    "rdfjs",
    "linked data"
  ],
  "main": "lib/index.js",
  "typings": "lib/index",
  "repository": "git@github.com:rubensworks/rdf-serialize.js.git",
  "author": "Ruben Taelman <rubensworks@gmail.com>",
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/rubensworks/"
  },
  "bugs": {
    "url": "https://github.com/rubensworks/rdf-serialize.js/issues"
  },
  "homepage": "https://github.com/rubensworks/rdf-serialize.js#readme",
  "license": "MIT",
  "files": [
    "lib/**/*.d.ts",
    "lib/**/*.js",
    "lib/**/*.js.map",
    "config",
    "components",
    "engine-default.js"
  ],
  "pre-commit": [
    "build",
    "lint",
    "test"
  ],
  "devDependencies": {
    "@comunica/runner": "^5.1.0",
    "@types/jest": "^30.0.0",
    "arrayify-stream": "^3.0.0",
    "componentsjs-generator": "^4.3.0",
    "jest": "^30.2.0",
    "manual-git-changelog": "^1.0.1",
    "pre-commit": "^1.2.2",
    "rdf-data-factory": "^2.0.2",
    "rdf-parse": "^5.0.0",
    "rdf-quad": "^2.0.0",
    "rdf-test-suite": "^2.1.4",
    "stream-to-string": "^1.1.0",
    "streamify-array": "^1.0.0",
    "ts-jest": "^29.4.6",
    "tslint": "^6.0.0",
    "tslint-eslint-rules": "^5.3.1",
    "typescript": "^5.9.3"
  },
  "jest": {
    "globals": {
      "ts-jest": {
        "tsConfig": "test/tsconfig.json"
      }
    },
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\].+\\.(js|jsx)$"
    ],
    "testRegex": "(/test/.*|(\\.|/)(test|spec))\\.ts$",
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "collectCoverage": true,
    "testEnvironment": "node"
  },
  "scripts": {
    "test": "jest ${1} --forceExit",
    "test-watch": "jest ${1} --watch",
    "lint": "tslint lib/index.ts lib/**/*.ts test/**/*.ts --exclude '**/*.d.ts'",
    "build": "npm run build:ts && npm run build:components",
    "build:ts": "tsc",
    "build:components": "componentsjs-generator",
    "browser": "webpack --config webpack.config.js --mode development",
    "validate": "npm ls",
    "prepare": "npm run build && comunica-compile-config config/config-default.json urn:comunica:default:Runner > engine-default.js",
    "version": "manual-git-changelog onversion"
  },
  "dependencies": {
    "@comunica/actor-rdf-serialize-jsonld": "^5.1.0",
    "@comunica/actor-rdf-serialize-n3": "^5.1.0",
    "@comunica/actor-rdf-serialize-shaclc": "^5.1.0",
    "@comunica/bus-init": "^5.1.0",
    "@comunica/bus-rdf-serialize": "^5.1.0",
    "@comunica/config-query-sparql": "^5.0.0",
    "@comunica/core": "^5.1.0",
    "@comunica/mediator-combine-pipeline": "^5.1.0",
    "@comunica/mediator-combine-union": "^5.1.0",
    "@comunica/mediator-race": "^5.1.0",
    "@comunica/context-entries": "^5.1.0",
    "@rdfjs/types": "*",
    "readable-stream": "^4.5.2",
    "stream-to-string": "^1.2.1"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
